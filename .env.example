# Copy to .env (git-ignored) and run: node --env-file=.env --experimental-strip-types apps/api/src/server.ts
# Never commit real keys. Values below are placeholders.

# demo (default, synthetic) | fixture (synthetic test file) | http (licensed provider contract)
MARKET_DATA_PROVIDER=demo

# fixture only (optional; defaults to apps/api/fixtures/market-fixture.json)
# MARKET_DATA_FIXTURE=apps/api/fixtures/market-fixture.json

# http only: a service you are licensed to use that serves the TradeLens provider contract (see README)
# MARKET_DATA_BASE_URL=https://your-adapter.example.com
# MARKET_DATA_API_KEY=replace-with-your-own-key
# MARKET_DATA_LICENSE=Personal, non-redistributable use under <vendor> terms dated <YYYY-MM-DD>
# MARKET_DATA_EXCHANGE=NSE
# MARKET_DATA_CURRENCY=INR
# MARKET_DATA_PROVIDER_ID=my-vendor
# MARKET_DATA_PROVIDER_NAME=My licensed vendor
# Holidays from the exchange's official holiday list, comma-separated:
# MARKET_DATA_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD
# MARKET_DATA_MAX_STALE_SESSIONS=0
# MARKET_DATA_TIMEOUT_MS=10000
# MARKET_DATA_MIN_INTERVAL_MS=250
# MARKET_DATA_CACHE_TTL_MS=60000
# MARKET_DATA_MAX_ATTEMPTS=4
