# Copy to .env (git-ignored) and run: node --env-file=.env --experimental-strip-types apps/api/src/server.ts
# Never commit real keys. Values below are placeholders.

# demo (default, synthetic) | fixture (synthetic test file) | http (licensed provider contract)
MARKET_DATA_PROVIDER=demo

# fixture only (optional; defaults to apps/api/fixtures/market-fixture.json)
# MARKET_DATA_FIXTURE=apps/api/fixtures/market-fixture.json

# http only: a service you are licensed to use that serves the TradeLens provider contract (see README)
# MARKET_DATA_BASE_URL=https://your-adapter.example.com
# MARKET_DATA_API_KEY=replace-with-your-own-key
# MARKET_DATA_LICENSE=Personal, non-redistributable use under <vendor> terms dated <YYYY-MM-DD>
# MARKET_DATA_EXCHANGE=NSE
# MARKET_DATA_CURRENCY=INR
# MARKET_DATA_PROVIDER_ID=my-vendor
# MARKET_DATA_PROVIDER_NAME=My licensed vendor
# Holidays from the exchange's official holiday list, comma-separated:
# MARKET_DATA_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD
# MARKET_DATA_MAX_STALE_SESSIONS=0
# MARKET_DATA_TIMEOUT_MS=10000
# MARKET_DATA_MIN_INTERVAL_MS=250
# MARKET_DATA_CACHE_TTL_MS=60000
# MARKET_DATA_MAX_ATTEMPTS=4

# Grounded research: offline mock by default. HTTP is a user-operated adapter.
RESEARCH_PROVIDER=mock
# RESEARCH_URL=https://your-trusted-adapter.example/research
# RESEARCH_API_KEY=private-runtime-secret
# Production requires a random token of at least 32 non-whitespace characters.
# API_ACCESS_TOKEN=private-runtime-secret

# MTF defaults to NSE official no-auth MCP (informational/non-commercial; delayed quotes).
# MTF_QUOTE_PROVIDER=nse
# Use disabled to turn off automatic quotes, or http for your licensed commercial adapter.
# MTF_QUOTE_PROVIDER=http
# Optional licensed quote adapter settings below; never point this to website scraping.
# POST request: { symbols: ["YOUR_NSE_SYMBOL"] }
# Response: { quotes: [{ symbol, priceInr: "100.00", marketAt: "<ISO instant>", source, mode: "LIVE" | "DELAYED" | "EOD" }] }
# MTF_QUOTE_URL=https://your-licensed-adapter.example/quotes
# MTF_QUOTE_API_KEY=private-runtime-secret
# MTF_QUOTE_LICENSE=Your authorized NSE data-use agreement

# Hosted multi-user MTF: PostgreSQL + a stable 32-byte encryption key (64 hex chars).
# DATABASE_URL=postgresql://user:password@host:5432/tradelens?sslmode=verify-full
# MTF_ENCRYPTION_KEY=<64 hex characters from your secret manager>
# MTF_APP_ORIGIN=https://your-website.example
# Explicitly enable self-registration for your hosted site when ready.
# MTF_ALLOW_REGISTRATION=true
# Development only: SQLite file (never commit databases or generated .key files).
# MTF_DB_PATH=.data/mtf.sqlite
# Zerodha read-only login: register this exact callback URL in Kite developer console.
# KITE_API_KEY=<your developer key>
# KITE_API_SECRET=<private server secret>
# KITE_REDIRECT_URL=https://your-website.example/api/mtf/broker/callback
