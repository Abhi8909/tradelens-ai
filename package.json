{
  "name": "tradelens-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types --watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @tradelens/web",
    "start:api": "node --experimental-strip-types apps/api/src/server.ts",
    "test": "node --experimental-strip-types --test packages/core/tests/*.test.ts apps/api/tests/*.test.ts",
    "build": "npm run build --workspace @tradelens/web",
    "typecheck": "npm run typecheck --workspace @tradelens/web && tsc -p apps/api/tsconfig.json",
    "test:e2e": "playwright test",
    "mtf:admin": "node --experimental-strip-types scripts/mtf-maintenance.ts",
    "rollovers:sync": "node --experimental-strip-types scripts/rollover-sync.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  }
}
